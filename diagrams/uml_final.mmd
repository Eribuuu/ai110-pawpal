classDiagram
    class Owner {
        +str name
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +remove_pet(pet: Pet) None
        +get_all_tasks() list~tuple~
    }

    class Pet {
        +str name
        +str species
        +list~Task~ tasks
        +add_task(task: Task) None
        +remove_task(task: Task) None
        +complete_task(task: Task) Task
        +get_tasks(day: date) list~Task~
        +display_tasks(day: date) str
    }

    class Task {
        +str title
        +int duration_minutes
        +Priority priority
        +time start_time
        +Frequency frequency
        +date due_date
        +bool completed
        +end_time() time
        +is_due_on(day: date) bool
        +mark_complete() None
        +next_occurrence() Task
    }

    class Priority {
        <<enumeration>>
        LOW
        MEDIUM
        HIGH
    }

    class Frequency {
        <<enumeration>>
        ONCE
        DAILY
        WEEKLY
    }

    class ScheduledTask {
        +Pet pet
        +Task task
        +str reason
    }

    class Schedule {
        +list~ScheduledTask~ scheduled
        +list~tuple~ skipped
        +total_minutes() int
    }

    class Scheduler {
        +create_schedule(owner: Owner, day: date) Schedule
        +sort_by_time(scheduled: list~ScheduledTask~) list~ScheduledTask~
        +filter_tasks(scheduled: list~ScheduledTask~, completed: bool, pet_name: str) list~ScheduledTask~
        +detect_conflicts(scheduled: list~ScheduledTask~) list~str~
        +display_schedule(schedule: Schedule) str
    }

    Owner "1" o-- "0..*" Pet : owns
    Pet "1" *-- "0..*" Task : has
    Task --> Priority : has
    Task --> Frequency : has
    Task ..> Task : next_occurrence creates
    Pet ..> Task : complete_task adds next occurrence
    Schedule "1" *-- "0..*" ScheduledTask : contains
    ScheduledTask "0..*" --> "1" Task : wraps
    ScheduledTask "0..*" --> "1" Pet : for
    Schedule ..> Pet : records skipped
    Schedule ..> Task : records skipped
    Scheduler ..> Owner : reads pets and tasks from
    Scheduler ..> Schedule : creates
    Scheduler ..> ScheduledTask : creates
