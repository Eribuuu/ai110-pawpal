classDiagram
    %% Keep this file updated so it matches your final implementation.

    class Owner {
        +str name
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +remove_pet(pet: Pet) None
        +get_all_tasks() list~tuple~
    }

    class Pet {
        +str name
        +str species
        +list~Task~ tasks
        +add_task(task: Task) None
        +remove_task(task: Task) None
    }

    class Task {
        +str title
        +int duration_minutes
        +Priority priority
        +time start_time
        +Frequency frequency
        +date start_date
        +bool completed
        +end_time() time
        +is_due_on(day: date) bool
    }

    class Priority {
        <<enumeration>>
        LOW
        MEDIUM
        HIGH
    }

    class Frequency {
        <<enumeration>>
        ONCE
        DAILY
        WEEKLY
    }

    class ScheduledTask {
        +Pet pet
        +Task task
        +str reason
    }

    class Schedule {
        +list~ScheduledTask~ scheduled
        +list~tuple~ skipped
        +total_minutes() int
    }

    class Scheduler {
        +create_schedule(owner: Owner, day: date) Schedule
    }

    Owner "1" o-- "0..*" Pet : owns
    Pet "1" *-- "0..*" Task : has
    Task --> Priority : has
    Task --> Frequency : has
    Schedule "1" *-- "0..*" ScheduledTask : contains
    ScheduledTask "0..*" --> "1" Task : wraps
    ScheduledTask "0..*" --> "1" Pet : for
    Schedule ..> Task : records skipped
    Scheduler ..> Owner : reads pets and tasks from
    Scheduler ..> Schedule : creates
