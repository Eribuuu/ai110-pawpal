classDiagram
    %% Keep this file updated so it matches your final implementation.

    class Owner {
        +str name
        +list~Pet~ pets
        +list~Task~ tasks
        +int free_time_minutes
        +add_pet(pet: Pet) None
        +remove_pet(pet: Pet) None
        +add_task(task: Task) None
        +remove_task(task: Task) None
        +get_tasks_for(pet: Pet) list~Task~
    }

    class Pet {
        +str name
        +str species
    }

    class Task {
        +str title
        +int duration_minutes
        +Priority priority
        +Pet pet
        +bool completed
    }

    class Priority {
        <<enumeration>>
        LOW
        MEDIUM
        HIGH
    }

    class ScheduledTask {
        +Task task
        +int start_minute
        +str reason
        +end_minute() int
    }

    class Schedule {
        +list~ScheduledTask~ scheduled
        +list~tuple~ skipped
        +total_minutes() int
    }

    class Scheduler {
        +create_schedule(owner: Owner) Schedule
    }

    Owner "1" o-- "0..*" Pet : owns
    Owner "1" o-- "0..*" Task : manages
    Task "0..*" --> "1" Pet : is for
    Task --> Priority : has
    Schedule "1" *-- "0..*" ScheduledTask : contains
    ScheduledTask "0..*" --> "1" Task : wraps
    Schedule ..> Task : records skipped
    Scheduler ..> Owner : reads tasks and free time from
    Scheduler ..> Schedule : creates
